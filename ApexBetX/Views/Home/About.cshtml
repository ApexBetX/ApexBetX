@{
    ViewData["Title"] = "About";
}

<div class="container section">

    <div class="card p-5">

        <h1 class="page-title text-center">About ApexBetX</h1>
        <hr />

        <p class="lead text-center">
            ApexBetX is a modern betting account management system designed to
            simplify the management of users, betting accounts, and transactions
            through a secure and user-friendly platform.
        </p>

    </div>

    <div class="row mt-5">

        <div class="col-md-4">
            <div class="card p-4 h-100">

                <h3>Our Story</h3>

                <p>
                    ApexBetX was created as part of an innovative software
                    solution to demonstrate how betting companies can manage
                    customer information, betting accounts, and financial
                    transactions efficiently using modern web technologies.
                </p>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">

                <h3>Our Mission</h3>

                <p>
                    Our mission is to provide a secure, reliable, and easy-to-use
                    platform that enables administrators to manage betting users,
                    accounts, and transactions while ensuring data integrity and
                    an excellent user experience.
                </p>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">

                <h3>What We Offer</h3>

                <ul>
                    <li>User Management</li>
                    <li>Betting Account Management</li>
                    <li>Transaction Tracking</li>
                    <li>Secure Data Management</li>
                    <li>Simple and Responsive Interface</li>
                </ul>

            </div>
        </div>

    </div>

</div>