@model ApexBetX.Models.Transaction

@{
    ViewData["Title"] = "Create Transaction";
}

<div class="container section">
    <div class="card p-4">

        <h1 class="page-title">Create Transaction</h1>
        <hr />

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AccountId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TransactionDate" class="form-label"></label>
                <input asp-for="TransactionDate" type="date" class="form-control" />
                <span asp-validation-for="TransactionDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransactionType" class="form-label"></label>
                <select asp-for="TransactionType" class="form-select">
                    <option value="">-- Select Type --</option>
                    <option value="Credit">Credit</option>
                    <option value="Debit">Debit</option>
                </select>
                <span asp-validation-for="TransactionType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- CaptureDate is NOT shown because the system sets it automatically -->

            <button type="submit" class="btn btn-primary">
                Save Transaction
            </button>

            <a asp-controller="BettingAccounts"
               asp-action="Details"
               asp-route-id="@Model.AccountId"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}