@model ApexBetX.Models.Transaction

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="container section">
    <div class="card p-4">

        <h1 class="page-title">Add Transaction</h1>
        
        <hr />
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }
        <div class="alert alert-warning">
            Editing this transaction will save the previous values in transaction history
            and recalculate the account balance correctly.
        </div>

        <form asp-action="Edit" asp-route-id="@Model.TransactionId" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="TransactionId" />
            <input type="hidden" asp-for="AccountId" />
            <input type="hidden" asp-for="CaptureDate" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TransactionDate" class="form-label"></label>
                <input asp-for="TransactionDate" type="date" class="form-control" />
                <span asp-validation-for="TransactionDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransactionType" class="form-label"></label>
                <select asp-for="TransactionType" class="form-select">
                    <option value="">-- Select Type --</option>
                    <option value="Deposit">Deposit</option>
                    <option value="Withdrawal">withdrawal</option>
                </select>
                <span asp-validation-for="TransactionType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-controller="BettingAccounts"
               asp-action="Details"
               asp-route-id="@Model.AccountId"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}