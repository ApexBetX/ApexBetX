@model IEnumerable<ApexBetX.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="container section">

    <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title">Users</h1>

            <div class="d-flex gap-2">

                <a class="btn btn-primary"
                   asp-controller="Users"
                   asp-action="Create">
                    Create New User
                </a>

                <a asp-controller="Users"
                    asp-action="ArchivedUsers"
                    class="btn btn-dark">
                    Archived Users
                </a>
            
            </div>
            
        </div>

        <form asp-controller="Users" asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by ID number, surname, or account number..." />

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>
            </div>
        </form>

        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>User ID</th>
                    <th>ID Number</th>
                    <th>First Name</th>
                    <th>Surname</th>
                    <th>Email</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserId</td>
                            <td>@user.IDNumber</td>
                            <td>@user.FirstName</td>
                            <td>@user.Surname</td>
                            <td>@user.Email</td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-info"
                                   asp-controller="Users"
                                   asp-action="Details"
                                   asp-route-id="@user.UserId">
                                    Details
                                </a>

                                <a class="btn btn-sm btn-warning"
                                   asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.UserId">
                                    Edit
                                </a>

                                <a class="btn btn-sm btn-danger"
                                   asp-controller="Users"
                                   asp-action="Archive"
                                   asp-route-id="@user.UserId">
                                    Archive
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No users found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
        }

    </div>

</div>