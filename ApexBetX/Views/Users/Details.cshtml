@model ApexBetX.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container section">
    <div class="card p-4 mb-4">
        <h1 class="page-title">User Details</h1>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">ID Number</dt>
            <dd class="col-sm-9">@Model.IDNumber</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Surname</dt>
            <dd class="col-sm-9">@Model.Surname</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning">
                Edit User
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Back to Users
            </a>
        </div>
    </div>

    <div class="card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title">Linked Betting Accounts</h2>

            <a asp-controller="BettingAccounts"
               asp-action="Create"
               asp-route-userId="@Model.UserId"
               class="btn btn-primary">
                Add Account
            </a>
        </div>

        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Account ID</th>
                    <th>Account Number</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.BettingAccounts != null && Model.BettingAccounts.Any())
                {
                    foreach (var account in Model.BettingAccounts)
                    {
                        <tr>
                            <td>@account.AccountId</td>
                            <td>@account.AccountNumber</td>
                            <td>R @account.Balance.ToString("N2")</td>
                            <td>
                                @if (account.IsClosed)
                                {
                                    <span class="badge bg-danger">Closed</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                            </td>
                            <td>@account.CreatedDate.ToShortDateString()</td>
                            <td class="text-center">
                                <a asp-controller="BettingAccounts"
                                   asp-action="Details"
                                   asp-route-id="@account.AccountId"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>

                                <a asp-controller="BettingAccounts"
                                   asp-action="Edit"
                                   asp-route-id="@account.AccountId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No betting accounts linked to this user.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>