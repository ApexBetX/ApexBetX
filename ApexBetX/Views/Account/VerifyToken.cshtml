@model ApexBetX.ViewModels.VerifyTokenViewModel

@{
    ViewData["Title"] = "Verify Email";
}

<div class="container section">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card p-4">

                <h1 class="page-title text-center">
                    Verify Email
                </h1>

                <p class="text-muted text-center">
                    Enter the 6-digit verification code sent to your email.
                </p>

                <hr />

                <form asp-controller="Account"
                      asp-action="VerifyToken"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="Email" />

                    <div class="mb-3">
                        <label class="form-label">
                            Email
                        </label>

                        <input type="text"
                               value="@Model.Email"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Token"
                               class="form-label">
                        </label>

                        <input asp-for="Token"
                               class="form-control"
                               placeholder="Enter 6-digit code"
                               maxlength="6"
                               autocomplete="one-time-code" />

                        <span asp-validation-for="Token"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">

                            Verify Email

                        </button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}