@model ApexBetX.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container section">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">

                <h1 class="page-title text-center">Login</h1>
                <hr />

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Login
                        </button>
                    </div>
                </form>

                <hr />

                <div class="text-center">
                    <a asp-controller="Account" asp-action="ForgotPassword">
                        Forgot Password?
                    </a>
                    <br />
                    <a asp-controller="Account" asp-action="Register">
                        Create an account
                    </a>
                    <a asp-controller="Account"
                       asp-action="ActivateAccount">
                        Activate Account
                    </a>
                    <a asp-controller="Account" asp-action="VerifyToken">
                        Verify Account
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}