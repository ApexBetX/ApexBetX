@model ApexBetX.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container section">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">

                <h1 class="page-title text-center">Reset Password</h1>
                <hr />

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input value="@Model.Email" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Token" class="form-label"></label>
                        <input asp-for="Token" class="form-control" placeholder="Enter reset code" />
                        <span asp-validation-for="Token" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Reset Password
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>